<div class="properties-index">
  <div class="page-header">
    <h1>Alle Immobilienangebote</h1>
    <div class="header-stats">
      <span><%= @total_count %> Angebote</span>
      <span><%= @recommended_count %> empfohlen</span>
      <span>Durchschnittsscore: <%= @avg_score %></span>
    </div>
    <div class="header-actions">
      <%= link_to 'Dashboard', dashboard_properties_path, class: 'btn btn-secondary' %>
      <%= link_to 'Screening starten', screen_properties_path, method: :post, class: 'btn btn-primary' %>
    </div>
  </div>

  <div class="filters-bar">
    <%= form_tag properties_path, method: :get, class: 'filter-form' do %>
      <div class="filter-group">
        <label>Bezirk</label>
        <%= select_tag :district,
            options_for_select([['Alle Bezirke', '']] + Property::BERLIN_DISTRICTS.map { |d| [d, d] }, params[:district]),
            class: 'filter-select' %>
      </div>

      <div class="filter-group">
        <label>Min. Zimmer</label>
        <%= select_tag :min_rooms,
            options_for_select([['Alle', '']] + (1..5).map { |r| ["#{r}+", r] }, params[:min_rooms]),
            class: 'filter-select' %>
      </div>

      <div class="filter-group">
        <label>Max. Preis</label>
        <%= select_tag :max_price,
            options_for_select([['Unbegrenzt', '']] + [500, 750, 1000, 1250, 1500, 2000].map { |p| ["bis #{p} EUR", p] }, params[:max_price]),
            class: 'filter-select' %>
      </div>

      <div class="filter-group">
        <label>Min. Fl&auml;che</label>
        <%= select_tag :min_space,
            options_for_select([['Alle', '']] + [30, 40, 50, 60, 80, 100].map { |s| ["ab #{s} m2", s] }, params[:min_space]),
            class: 'filter-select' %>
      </div>

      <div class="filter-group">
        <label>Sortierung</label>
        <%= select_tag :sort,
            options_for_select([
              ['Beste Bewertung', 'score'],
              ['Preis aufsteigend', 'price_asc'],
              ['Preis absteigend', 'price_desc'],
              ['Gr&ouml;&szlig;te zuerst', 'size_desc'],
              ['Neueste zuerst', 'newest']
            ], params[:sort]),
            class: 'filter-select' %>
      </div>

      <%= submit_tag 'Filtern', class: 'btn btn-primary filter-submit' %>
    <% end %>
  </div>

  <div class="property-cards">
    <% @properties.each do |property| %>
      <%= render 'properties/property_card', property: property %>
    <% end %>
  </div>

  <% if @properties.empty? %>
    <div class="empty-state">
      <h2>Keine Angebote gefunden</h2>
      <p>Passe deine Filter an oder starte ein neues Screening.</p>
    </div>
  <% end %>
</div>
